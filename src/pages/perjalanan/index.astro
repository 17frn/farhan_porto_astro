---
import Layout from "../../layouts/Layout.astro";
import TimelineView from "../../components/TimelineView.vue";
import GlobalMapModal from "../../components/GlobalMapModal.vue";
import { getSortedTimeline } from "../../data/timeline";
---

<Layout title="Galeri & Jejak Langkah">
  <TimelineView client:load items={getSortedTimeline()} />

  <!-- Global Map Modal mounted here but initially closed. We use an event listener to open it. -->
  <global-map-island>
    <GlobalMapModal client:load markers={getSortedTimeline()} />
  </global-map-island>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const trigger = document.getElementById("global-map-trigger");
    if (trigger) {
      trigger.addEventListener("click", () => {
        window.dispatchEvent(new Event("open-global-map"));
      });
    }
  });
</script>
