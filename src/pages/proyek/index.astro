---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.vue";
import { projectItems } from "../../data/proyek";
---

<Layout title="Katalog Proyek">
  <div class="page-header">
    <h1 class="page-title">Katalog Projek</h1>
    <p class="page-subtitle">
      Daftar projek yang sudah dan sedang saya kerjakan.
    </p>
  </div>

  <div class="projects-grid">
    {
      projectItems.map((project) => (
        <ProjectCard
          title={project.title}
          category={project.category}
          description={project.description}
          thumbnail={project.thumbnail}
          link={`/proyek/${project.id}`}
        />
      ))
    }
  </div>
</Layout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: 50px;
    margin-top: 40px;
    position: relative;
    z-index: 2;
    background-color: var(--bg-color);
    padding: 20px 0;
  }

  .page-title {
    font-size: 2.5rem;
    color: var(--accent-3);
    margin: 0 0 10px 0;
    font-weight: 700;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 30px;
    padding: 0 0 50px 0;
  }
</style>
