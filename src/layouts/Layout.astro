---
interface Props {
  title: string;
}

const { title } = Astro.props;
import DynamicIsland from "../components/DynamicIsland.vue";
import FloatingIcons from "../components/FloatingIcons.vue";
import "../styles/cards.css";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Portofolio Farhan R - Jejak Langkah & Galeri"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
      integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <title>{title}</title>
  </head>
  <body>
    <FloatingIcons
      client:only="vue"
      isDarkTheme={false}
      count={20}
      sizeModifier={1.6}
    />
    <DynamicIsland client:load />
    <div class="portfolio-container">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg-color: #f8fafc;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --accent-1: #6366f1;
    --accent-2: #14b8a6;
    --accent-3: #0ea5e9;
    --accent-4: #f43f5e;
    --accent-5: #8b5cf6;
    --accent-6: #f59e0b;
    --accent-7: #fd7979;
    --accent-8: #3f9aae;
    --border-light: #e2e8f0;
  }

  html {
    font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-main);
  }

  body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    position: relative;
    min-height: 100vh;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  /* === DESKTOP (> 1024px) === */
  .portfolio-container {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 40px;
  }

  /* === TABLET (481px - 1024px) === */
  @media (max-width: 1024px) {
    .portfolio-container {
      padding: 50px 30px;
    }
  }

  /* === MOBILE (≤ 480px) === */
  @media (max-width: 480px) {
    .portfolio-container {
      padding: 20px 16px;
    }
  }
</style>
